# Ce fichier est un modele de developpement. Les valeurs ci-dessous font
# tourner l'application en local ; celles qui doivent changer a la mise
# en production portent chacune leur consigne.

APP_NAME=NBLogiTrack

# En production : APP_ENV=production et APP_DEBUG=false. Laisse a true,
# la page d'erreur affiche la trace d'execution, les requetes SQL et le
# contenu des variables d'environnement au premier plantage venu.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_BE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Les proxies dont on accepte les en-tetes X-Forwarded-*. A remplir a la
# mise en production, avec l'adresse du reverse proxy ou de l'equilibreur
# de charge, separees par des virgules ; « * » fait confiance a tout ce
# qui est en amont, ce qui ne convient que si l'application n'est jamais
# joignable directement. Vide, on ne fait confiance a personne : c'est le
# bon defaut en local.
TRUSTED_PROXIES=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# En production : LOG_LEVEL=warning. Le niveau debug ecrit dans les
# journaux le detail de chaque requete, adresses et identifiants
# compris, sur un serveur ou personne ne les relit jamais.
LOG_LEVEL=debug

# En production : un compte PostgreSQL dedie a l'application, avec un
# mot de passe, et surtout pas le superutilisateur « postgres ». Une
# injection reussie ne doit pas donner la main sur le serveur entier.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nblogitrack
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# En production : SESSION_ENCRYPT=true. Le pilote « database » ecrit la
# session en clair dans la table « sessions », ou figurent notamment la
# langue et l'identifiant du compte.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# En production : SESSION_SECURE_COOKIE=true, des lors que le site est
# servi en HTTPS. Sans ce reglage le navigateur envoie aussi le cookie de
# session sur une simple requete http, ou n'importe quel intermediaire du
# reseau peut le lire et se faire passer pour l'utilisateur.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En developpement, les e-mails sont interceptes par Mailpit (SMTP 1025, interface 8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@nblogitrack.be"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
